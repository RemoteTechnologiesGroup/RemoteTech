<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>RemoteTech</AssemblyName>
    <RootNamespace>RemoteTech</RootNamespace>
    <TargetFramework>net481</TargetFramework>

    <Description>Satellite network and signal delay for Kerbal Space Program</Description>
    <Company>RemoteTechnologiesGroup</Company>
    <Product>RemoteTech</Product>
    <Copyright>Copyright © 2013-2021</Copyright>

    <KSPBT_ModRoot>$(ProjectRootDir)GameData\RemoteTech</KSPBT_ModRoot>
    <KSPBT_ModPluginFolder>Plugins</KSPBT_ModPluginFolder>

    <LangVersion>12</LangVersion>
    <DebugType>portable</DebugType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Configurations>Debug;Release</Configurations>

    <Version>1.9.12</Version>
    <FileVersion>1.9.12</FileVersion>
    <!-- AssemblyVersion is pinned to major.minor so dependent DLLs don't break on every patch release. -->
    <AssemblyVersion>1.9.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="KSPBuildTools" Version="1.1.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <AssemblyMetadata Include="HotReload" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <KSPVersionFile Include=".">
      <Destination>$(KSPBT_ModRoot)/Versioning/RemoteTech.version</Destination>
      <URL>https://github.com/RemoteTechnologiesGroup/RemoteTech/releases/latest/download/RemoteTech.version</URL>
      <Download>https://github.com/RemoteTechnologiesGroup/RemoteTech/releases</Download>
      <KSP_Version>1.12.5</KSP_Version>
      <KSP_Version_Min>1.12.0</KSP_Version_Min>
      <KSP_Version_Max>1.12.99</KSP_Version_Max>
    </KSPVersionFile>
  </ItemGroup>
</Project>
